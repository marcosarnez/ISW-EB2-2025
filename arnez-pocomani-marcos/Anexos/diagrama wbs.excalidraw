      "seed": 198209025,
      "version": 384,
      "versionNonce": 584977188,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1748029179966,
      "link": null,
      "locked": false,
      "text": "Como administrador del\nsistema, quiero recibir\nalertas automáticas\ncuando el chatbot\nexperimente fallas o se\nquede sin respuesta,\npara poder intervenir\nde inmediato. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "n5CmOglVNPH_9PY9VNr5T",
      "originalText": "Como administrador del sistema, quiero recibir alertas automáticas cuando el chatbot experimente fallas o se quede sin respuesta, para poder intervenir de inmediato. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "F8g_DWcrm4doW10pCPvV3",
      "type": "rectangle",
      "x": 1226.4599937384965,
      "y": 2462.1857622587163,
      "width": 234.66668701171875,
      "height": 285,
      "angle": 0,
