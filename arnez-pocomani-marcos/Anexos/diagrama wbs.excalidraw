      "seed": 754945441,
      "version": 300,
      "versionNonce": 98201380,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1748029083797,
      "link": null,
      "locked": false,
      "text": "Como desarrollador del\nchatbot, quiero una\nherramienta para\nmapear las preguntas\nde los clientes a\nrespuestas\npredefinidas, para\nagilizar la\nconfiguración inicial del\nchatbot",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "N-obIL_FLJOu9TWon_fol",
      "originalText": "Como desarrollador del chatbot, quiero una herramienta para mapear las preguntas de los clientes a respuestas predefinidas, para agilizar la configuración inicial del chatbot",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5RizS6zXyWOvUlYMeM95r",
      "type": "rectangle",
      "x": 410.5474446614581,
      "y": 2727.757130031109,
