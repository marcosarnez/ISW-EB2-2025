      "versionNonce": 163112356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1748029205907,
      "link": null,
      "locked": false,
      "text": "Como desarrollador del\nchatbot, quiero una\nherramienta para\nmonitorear el tiempo\nde respuesta del\nchatbot, para asegurar\nque la experiencia del\nusuario sea fluida y\nsin esperas. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w-fyCRYUInS550NiriC3E",
      "originalText": "Como desarrollador del chatbot, quiero una herramienta para monitorear el tiempo de respuesta del chatbot, para asegurar que la experiencia del usuario sea fluida y sin esperas. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
