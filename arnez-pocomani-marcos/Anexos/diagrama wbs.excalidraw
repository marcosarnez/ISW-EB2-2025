    {
      "id": "DvuNciAul4gHp0p38n-4M",
      "type": "text",
      "x": 1247.4670443371613,
      "y": 2823.899597994111,
      "width": 216.77981567382812,
      "height": 250,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
