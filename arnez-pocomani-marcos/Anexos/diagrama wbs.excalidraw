    {
      "id": "dsJanfZjV6QYZerEz6cV2",
      "type": "text",
      "x": 967.2581496465768,
      "y": 2531.109461312375,
      "width": 224.31982421875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
