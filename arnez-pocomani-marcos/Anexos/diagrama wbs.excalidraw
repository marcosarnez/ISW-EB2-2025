      "locked": false
    },
    {
      "id": "PNI842Iri1G0jejJ51vtB",
      "type": "text",
      "x": 691.241864522298,
      "y": 2467.566770098075,
      "width": 224.03981018066406,
      "height": 225,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3r",
      "roundness": null,
      "seed": 785079695,
      "version": 235,
      "versionNonce": 261404616,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1748028982918,
      "link": null,
      "locked": false,
      "text": "Como analista de\ndatos, quiero\nidentificar los términos\ny palabras clave más\nusados por los clientes\nen sus preguntas, para\nque el chatbot\nentienda mejor las\nintenciones. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "xNEasA-ZvpLEgNS3QkgJy",
      "originalText": "Como analista de datos, quiero identificar los términos y palabras clave más usados por los clientes en sus preguntas, para que el chatbot entienda mejor las intenciones. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
