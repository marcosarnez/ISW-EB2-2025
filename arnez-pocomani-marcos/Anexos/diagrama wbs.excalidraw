    },
    {
      "id": "_yoA2SO9l7H2HBiOipIgO",
      "type": "text",
      "x": 430.9618650163919,
      "y": 2437.562304105511,
      "width": 212.95982360839844,
      "height": 250,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 1080672481,
      "version": 249,
      "versionNonce": 75744968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1748028967468,
      "link": null,
      "locked": false,
      "text": "Como especialista en\natención al cliente,\nquiero categorizar las\npreguntas recurrentes\npor temas (ej. envíos,\ndevoluciones,\nproductos), para\norganizar de forma\nlógica el conocimiento\ndel chatbot. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Q9X8VJuRPSuUsLl9k6ZEM",
      "originalText": "Como especialista en atención al cliente, quiero categorizar las preguntas recurrentes por temas (ej. envíos, devoluciones, productos), para organizar de forma lógica el conocimiento del chatbot. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xNEasA-ZvpLEgNS3QkgJy",
      "type": "rectangle",
      "x": 685.9284261067706,
      "y": 2437.566770098075,
      "width": 234.66668701171875,
      "height": 285,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
