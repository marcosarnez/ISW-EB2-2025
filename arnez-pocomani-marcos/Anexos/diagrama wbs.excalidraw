      "versionNonce": 549614625,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1747957220444,
      "link": null,
      "locked": false,
      "text": "Como cliente nuevo,\nquiero que el chatbot\nnunca falle ni se quede\ncolgado, para tener\nuna experiencia\nperfecta cada vez que\nlo uso.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "1yXBTHLQjil39Wed9tu_y",
      "originalText": "Como cliente nuevo, quiero que el chatbot nunca falle ni se quede colgado, para tener una experiencia perfecta cada vez que lo uso.",
      "autoResize": true,
      "lineHeight": 1.25
    },
