      "locked": false
    },
    {
      "id": "AbfqGTDBQVqri9xkSbHlr",
      "type": "text",
      "x": 417.5308736165362,
      "y": 2732.757130031109,
      "width": 220.6998291015625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3w",
      "roundness": null,
      "seed": 318957935,
      "version": 283,
      "versionNonce": 746053020,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1748029072149,
      "link": null,
      "locked": false,
      "text": "Como gerente de\nproducto, quiero\nconocer las\nexpectativas no\nsatisfechas de los\nclientes a través de\nsus preguntas\nfrecuentes, para\nmejorar la información\nofrecida por el\nchatbot y reducir la\nnecesidad de contacto\nhumano. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "5RizS6zXyWOvUlYMeM95r",
      "originalText": "Como gerente de producto, quiero conocer las expectativas no satisfechas de los clientes a través de sus preguntas frecuentes, para mejorar la información ofrecida por el chatbot y reducir la necesidad de contacto humano. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
